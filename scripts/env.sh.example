export GCP_PROJECT_ID="your-gcp-project-id"
export GCP_REGION="southamerica-west1"
export GCP_ZONE="southamerica-west1-a"
export GKE_CLUSTER_NAME="xonotic-mvp"
export XONOTIC_SERVER_POOL_ID="south-america-default"
export XONOTIC_SERVER_POOL_DISPLAY_NAME="South America - Default"
export XONOTIC_SERVER_REGION="south-america"
export XONOTIC_AGONES_NAMESPACE="xonotic-agones"
export XONOTIC_FLEET_NAME="xonotic-fleet"
export XONOTIC_UDP_PORT_RANGE="7000-7010"
export XONOTIC_RCON_PASSWORD="change-me-local-dev-password"
export XONOTIC_POSTGRES_DB="xonotic"
export XONOTIC_POSTGRES_USER="xonotic"
export XONOTIC_POSTGRES_PASSWORD="change-me-local-dev-db-password"
export XONOTIC_REQUIRED_READY_REPLICAS="1"

# up.sh normally selects the newest successful automatic master publication.
# Pin a previously published coordinated release for rollback or recovery:
# export XONOTIC_RELEASE_SHA="<full-40-character-git-sha>"
# Release lookup and GHCR image validation require curl, jq, and network access.

# Source GKE contexts used to build the central allocator's scoped kubeconfig.
# Defaults are derived from GCP_PROJECT_ID and the documented cluster locations.
# Uncomment an override only when a local gcloud context has a different name.
# The generated backend contexts use stable server-pool IDs.
# Refresh source credentials as described in docs/region-server-pools.md, then run:
#   ./scripts/build-multicluster-kubeconfig.sh
# export XONOTIC_SOUTH_AMERICA_SOURCE_KUBE_CONTEXT="custom-sa-context"
# export XONOTIC_EUROPE_SOURCE_KUBE_CONTEXT="custom-eu-context"
# export XONOTIC_NORTH_AMERICA_SOURCE_KUBE_CONTEXT="custom-na-context"
export XONOTIC_MULTICLUSTER_KUBECONFIG="scripts/.generated/xonotic-multicluster.kubeconfig"

# Region game-server-plane scripts:
#   ./scripts/up-region.sh europe
#   ./scripts/up-region.sh north-america
#   ./scripts/down-region.sh europe
# They use GCP_PROJECT_ID, XONOTIC_RCON_PASSWORD,
# infra/regions/<region>.tfvars, and Terraform workspaces. up-region.sh
# provisions the regional GKE/firewall layer and deploys Agones plus the
# Xonotic Fleet/FleetAutoscaler, but not backend/frontend/Postgres.
# Admin View auth. Player View remains public/read-only.
# Generate these values with:
#   scripts/generate-admin-auth.sh --username admin --password admin
# Paste the generated export lines below. Keep the single quotes around
# ADMIN_PASSWORD_HASH because Werkzeug hashes contain "$" separators.
export ADMIN_USERNAME="admin"
export ADMIN_PASSWORD_HASH=""
export ADMIN_SESSION_SECRET=""
